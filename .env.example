# Daily comment digest (src/notify). Sent via the Gmail API (not SMTP —
# Railway blocks outbound SMTP ports). Uses a separate OAuth client from
# GOOGLE_CLIENT_ID/SECRET above (Google Cloud Console -> Credentials -> OAuth
# client ID -> Desktop app), scope https://www.googleapis.com/auth/gmail.send.
# Run scripts/gmail_oauth_setup.py once locally to obtain GMAIL_REFRESH_TOKEN.
# MAIL_FROM must be the Gmail address that granted consent, e.g.
# "Aquinas Pipeline <you@gmail.com>".
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_FROM=
PUBLIC_BASE_URL=
